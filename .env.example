# Where callbacks are forwarded — the NaiPol backend's own callback endpoint.
BACKEND_CALLBACK_URL=https://backend.naipol.com/api/wallet/mpesa/callback/
# B2C (withdrawal) endpoints — default to the same host as BACKEND_CALLBACK_URL.
#BACKEND_B2C_RESULT_URL=https://backend.naipol.com/api/wallet/mpesa/b2c/result/
#BACKEND_B2C_TIMEOUT_URL=https://backend.naipol.com/api/wallet/mpesa/b2c/timeout/
# Shared secret, sent as X-Callback-Secret. Must equal the backend's
# SAFARICOM_DARAJA_CALLBACK_SECRET. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FORWARD_SECRET=
# Optional unguessable path segment — the CallBackURL becomes
# https://<this-host>/mpesa/callback/<CALLBACK_PATH_TOKEN>/
CALLBACK_PATH_TOKEN=
# Callbacks that couldn't be delivered (replay with `python app.py replay`).
SPOOL_FILE=undelivered_callbacks.jsonl
PORT=8080
